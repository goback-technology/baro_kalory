{
  "name": "baro-kalory",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "description": "PTZ CCTV 커미셔닝 콘솔 웹 UI — React SPA(해시 라우팅), 정적 호스팅.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i styles/tailwind.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i styles/tailwind.css -o public/app.css --watch",
    "build": "pnpm run build:css",
    "build:dist": "pnpm run build:css && vite build",
    "test": "node --test \"test/**/*.test.mjs\" \"src/**/*.test.mjs\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
