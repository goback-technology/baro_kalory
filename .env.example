# 개발용 정적 서버(server.mjs) 설정. `cp .env.example .env` 후 값을 고친다.
# .env 는 gitignore 다 — 호스트마다 다르고, 주소를 저장소에 커밋하지 않는다.
#
# 우선순위: CLI 플래그 > 이미 셸에 있는 환경변수 > .env > 기본값.

# 서빙 포트. 808x/809x 는 UE 시뮬레이터 카메라 대역이라 피한다.
BARO_FRONTEND_PORT=8180

# 바인딩 주소. 이 프록시는 무인증이라 LAN 노출은 명시적 선택이어야 한다.
BARO_FRONTEND_HOST=127.0.0.1

# 마운트 프리픽스. 기본은 루트("") — 한 호스트에서 여러 서비스를 구분하는 배포에서만 준다.
# 예: BARO_FRONTEND_BASE=/calory
BARO_FRONTEND_BASE=

# 프록시할 backend 주소(마운트가 있다면 경로까지 포함).
# 예: http://192.0.2.10:3002/calory  ·  https://backend.example.com/calory
BARO_BACKEND_URL=http://127.0.0.1:3002/calory
